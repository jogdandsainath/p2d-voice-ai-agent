{
  "name": "p2d-voice-ai-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "P2D Voice AI Agent - Enterprise Multi-Agent Voice AI Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:call": "tsx scripts/test-single-call.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "db:generate": "npm run generate --workspace=@p2d/database",
    "db:push": "npm run push --workspace=@p2d/database",
    "db:seed": "npm run seed --workspace=@p2d/database",
    "start:api": "npm run start --workspace=@p2d/api",
    "start:worker": "npm run start --workspace=@p2d/worker",
    "start:web": "npm run start --workspace=@p2d/web"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

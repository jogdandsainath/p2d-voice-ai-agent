# ==============================================================================
# P2D Voice AI Agent Platform - Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2d_voice?schema=public

# Redis & Task Queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=p2d_dev_jwt_secret_must_be_at_least_32_chars_long_123456
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Telephony Providers
# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+14155552671

# India PSTN / SIP / Exotel Telephony
INDIA_SIP_HOST=sip.indiatsp.p2d.internal
INDIA_SIP_USER=p2d_voice_sip
INDIA_SIP_PASSWORD=secret_sip_pass

# Voice Providers (TTS & STT)
# ElevenLabs
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# LLM Providers
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Downstream Integrations & P2D Command Center
P2D_COMMAND_CENTER_URL=https://command-center.p2d.ai/api/v1
P2D_WEBHOOK_SECRET=whsec_p2d_signature_secret_key_123

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users               User[]
  agents              Agent[]
  phoneNumbers        PhoneNumber[]
  calls               Call[]
  conversations       Conversation[]
  actions             Action[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  integrations        Integration[]
  auditLogs           AuditLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           String   @default("Builder") // Owner, Admin, Builder, Operator, Analyst, Viewer
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Agent {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  name               String
  description        String
  avatarUrl          String?  @map("avatar_url")
  status             String   @default("Draft") // Draft, Testing, Published, Paused, Archived
  publishedVersionId String?  @map("published_version_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions           AgentVersion[]
  phoneNumbers       PhoneNumber[]
  calls              Call[]
  conversations      Conversation[]
  knowledgeSources   KnowledgeSource[]

  @@index([organizationId])
  @@map("agents")
}

model AgentVersion {
  id             String   @id @default(uuid())
  agentId        String   @map("agent_id")
  versionNumber  String   @map("version_number")
  systemPrompt   String   @map("system_prompt")
  personality    String
  voiceProvider  String   @default("elevenlabs") @map("voice_provider")
  voiceId        String   @map("voice_id")
  voiceSettings  Json?    @map("voice_settings")
  language       String   @default("en-US")
  modelProvider  String   @default("openai") @map("model_provider")
  modelName      String   @default("gpt-4o") @map("model_name")
  temperature    Float    @default(0.7)
  tools          Json?
  guardrails     Json?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_versions")
}

model KnowledgeSource {
  id          String   @id @default(uuid())
  agentId     String   @map("agent_id")
  type        String   // document, url, text_snippet
  title       String
  contentText String?  @map("content_text")
  sourceUrl   String?  @map("source_url")
  status      String   @default("ready")
  createdAt   DateTime @default(now()) @map("created_at")

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("knowledge_sources")
}

model PhoneNumber {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  phoneNumber         String   @unique @map("phone_number")
  provider            String   @default("twilio") // twilio, india_sip, exotel, mock
  assignedAgentId     String?  @map("assigned_agent_id")
  friendlyName        String?  @map("friendly_name")
  recordingEnabled    Boolean  @default(true) @map("recording_enabled")
  consentAnnouncement Boolean  @default(true) @map("consent_announcement")
  businessHours       Json?    @map("business_hours")
  fallbackNumber      String?  @map("fallback_number")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAgent       Agent?       @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  calls               Call[]

  @@index([organizationId])
  @@map("phone_numbers")
}

model Call {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  agentId           String    @map("agent_id")
  phoneNumberId     String?   @map("phone_number_id")
  providerCallSid   String    @unique @map("provider_call_sid")
  direction         String    @default("inbound") // inbound, outbound
  callerNumber      String    @map("caller_number")
  destinationNumber String    @map("destination_number")
  status            String    @default("initiated") // initiated, ringing, in_progress, completed, failed, busy, no_answer
  startedAt         DateTime  @default(now()) @map("started_at")
  answeredAt        DateTime? @map("answered_at")
  endedAt           DateTime? @map("ended_at")
  durationSeconds   Int?      @map("duration_seconds")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent             Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  phoneNumber       PhoneNumber?   @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  conversation      Conversation?
  recording         CallRecording?

  @@index([organizationId, createdAt])
  @@map("calls")
}

model CallRecording {
  id                  String   @id @default(uuid())
  callId              String   @unique @map("call_id")
  providerRecordingSid String? @map("provider_recording_sid")
  recordingUrl        String   @map("recording_url")
  durationSeconds     Int?     @map("duration_seconds")
  status              String   @default("completed") // processing, completed, deleted
  retentionExpiresAt  DateTime? @map("retention_expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  call                Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_recordings")
}

model Conversation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  callId         String   @unique @map("call_id")
  agentId        String   @map("agent_id")
  sessionState   String   @default("CREATED") // CREATED, CONNECTING, ACTIVE, ON_HOLD, TRANSFERRING, COMPLETED, FAILED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call           Call                   @relation(fields: [callId], references: [id], onDelete: Cascade)
  agent          Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]
  analysis       ConversationAnalysis?
  actions        Action[]
  executions     WorkflowExecution[]

  @@index([organizationId, createdAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  speaker        String   // agent, customer, system
  text           String
  startTime      Float    @map("start_time")
  endTime        Float    @map("end_time")
  confidence     Float?   @default(1.0)
  toolCalls      Json?    @map("tool_calls")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

model ConversationAnalysis {
  id             String   @id @default(uuid())
  conversationId String   @unique @map("conversation_id")
  summary        String
  intent         String
  outcome        String
  sentiment      String   @default("neutral") // positive, neutral, negative, mixed
  priority       String   @default("medium")  // low, medium, high, urgent
  customerName   String?  @map("customer_name")
  organization   String?
  phone          String?
  email          String?
  topics         Json?
  objections     Json?
  commitments    Json?
  nextBestAction String   @map("next_best_action")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_analysis")
}

model Action {
  id              String    @id @default(uuid())
  conversationId  String    @map("conversation_id")
  organizationId  String    @map("organization_id")
  actionType      String    @map("action_type")
  description     String
  owner           String    @default("sales")
  priority        String    @default("medium")
  dueDate         DateTime? @map("due_date")
  status          String    @default("Detected") // Detected, Pending, Running, Completed, Failed, Cancelled
  confidence      Float     @default(0.95)
  sourceMessage   String?   @map("source_message")
  workflowId      String?   @map("workflow_id")
  executionResult Json?     @map("execution_result")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("actions")
}

model Workflow {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  triggerType    String   @default("Call Completed") @map("trigger_type")
  isActive       Boolean  @default(true) @map("is_active")
  nodes          Json     // Array of WorkflowNode objects
  edges          Json     // Array of WorkflowEdge objects
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions     WorkflowExecution[]

  @@index([organizationId])
  @@map("workflows")
}

model WorkflowExecution {
  id             String    @id @default(uuid())
  workflowId     String    @map("workflow_id")
  organizationId String    @map("organization_id")
  conversationId String    @map("conversation_id")
  status         String    @default("RUNNING") // RUNNING, COMPLETED, FAILED, CANCELLED
  triggerPayload Json      @map("trigger_payload")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  errorMessage   String?   @map("error_message")

  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  steps          WorkflowExecutionStep[]

  @@index([organizationId, startedAt])
  @@map("workflow_executions")
}

model WorkflowExecutionStep {
  id           String    @id @default(uuid())
  executionId  String    @map("execution_id")
  nodeId       String    @map("node_id")
  nodeType     String    @map("node_type")
  status       String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, SKIPPED
  inputData    Json?     @map("input_data")
  outputData   Json?     @map("output_data")
  errorMessage String?   @map("error_message")
  durationMs   Int?      @map("duration_ms")
  createdAt    DateTime  @default(now()) @map("created_at")

  execution    WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_execution_steps")
}

model Integration {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  provider       String   // webhook, salesforce, hubspot, zoho, slack, p2d_command_center
  name           String
  baseUrl        String   @map("base_url")
  authType       String   @default("none") @map("auth_type")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials    IntegrationCredential?

  @@index([organizationId])
  @@map("integrations")
}

model IntegrationCredential {
  id                   String   @id @default(uuid())
  integrationId        String   @unique @map("integration_id")
  encryptedCredentials String   @map("encrypted_credentials")
  iv                   String
  authTag              String   @map("auth_tag")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  integration          Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  details        Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
